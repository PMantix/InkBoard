{
  "name": "inkboard",
  "productName": "Inkboard",
  "version": "0.1.0",
  "description": "A local, pen-first infinite whiteboard for Windows and macOS.",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"vite\" \"wait-on tcp:5173 && cross-env INKBOARD_DEV_URL=http://localhost:5173 electron .\"",
    "build": "vite build",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dist:win": "npm run build && electron-builder --win --publish never -c.electronDist=node_modules/electron/dist",
    "dist:mac": "npm run build && electron-builder --mac --publish never"
  },
  "build": {
    "appId": "dev.pmantix.inkboard",
    "productName": "Inkboard",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json",
      "build/icon.png"
    ],
    "icon": "build/icon.png",
    "artifactName": "Inkboard-${version}-${os}-${arch}.${ext}",
    "fileAssociations": [
      {
        "ext": "inkboard",
        "name": "Inkboard board",
        "role": "Editor",
        "icon": "build/icon.png"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Inkboard",
      "artifactName": "Inkboard-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "identity": "-"
    },
    "dmg": {
      "artifactName": "Inkboard-${version}-mac.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "PMantix",
      "repo": "InkBoard",
      "releaseType": "release"
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wait-on": "^9.5.1"
  },
  "author": "Phillip Aquino"
}
